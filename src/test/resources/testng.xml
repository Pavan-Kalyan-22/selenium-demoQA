<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >
<suite name="SeleniumFrameworkSuite" verbose="1" parallel="true" thread-count = "2">
  
  <!-- Register Test Listeners -->
  <listeners>
    <listener class-name="com.selenium.practice.listeners.TestExecutionListener"/>
    <listener class-name="com.selenium.practice.listeners.InvokedMethodListener"/>
  </listeners>
  
  <test name="ProductSelect">
    <packages>
      <package name="com.selenium.practice.tests.checkoutflow"/>
    </packages>
  </test>
  <test name="SingleProductSelect">
    <packages>
      <package name="com.selenium.practice.tests.checkoutflow"/>
    </packages>
  </test>
</suite>


