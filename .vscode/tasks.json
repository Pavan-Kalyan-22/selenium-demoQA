{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Allure: Run Cucumber Tests & Report",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/run-tests.ps1",
                "-Suite",
                "cucumber"
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Allure: Run TestNG Tests & Report",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/run-tests.ps1",
                "-Suite",
                "testng"
            ],
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Allure: Generate Report Only",
            "type": "shell",
            "command": "allure",
            "args": [
                "generate",
                "${workspaceFolder}/allure-results",
                "--clean",
                "-o",
                "${workspaceFolder}/allure-report"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Allure: Open Report",
            "type": "shell",
            "command": "allure",
            "args": [
                "open",
                "${workspaceFolder}/allure-report"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": []
        }
    ]
}
